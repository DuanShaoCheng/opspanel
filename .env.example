# OpsPanel 环境变量配置
# 复制此文件为 .env 并按需修改

# === 必填：日志目录 ===
# 宿主机上要监控的日志目录，会以只读方式挂载到容器 /mnt/logs
LOG_DIR=/var/log

# === 基本 ===
TZ=Asia/Shanghai
LISTEN_PORT=9090

# === 数据库 ===
# 支持 sqlite / mysql / postgres，默认 sqlite
# DB_DRIVER=sqlite
# DB_DSN=/data/sentinel.db
# DB_DRIVER=mysql
# DB_DSN=user:pass@tcp(127.0.0.1:3306)/log_sentinel?charset=utf8mb4&parseTime=True
# DB_DRIVER=postgres
# DB_DSN=host=127.0.0.1 user=admin password=pass dbname=log_sentinel port=5432 sslmode=disable

# === JWT ===
# 用于签发登录 token 的密钥，生产环境务必修改
# JWT_SECRET=your-secret-key-change-me

# === LLM 配置 ===
# LOG_SENTINEL_LLM_URL=https://api.deepseek.com/v1/chat/completions
# LOG_SENTINEL_LLM_KEY=sk-your-api-key
# LOG_SENTINEL_LLM_MODEL=deepseek-chat
# LOG_SENTINEL_LLM_PROMPT=你是一个服务器运维专家...

# === 定时任务 ===
# LOG_SENTINEL_SCHEDULE_ENABLED=true
# LOG_SENTINEL_SCHEDULE_CRON=0 9 * * *
# LOG_SENTINEL_SCHEDULE_HOURS=24
# LOG_SENTINEL_SCHEDULE_MAX_BYTES=12000

# === 快速通知渠道（仅当 config.json 中无渠道时生效） ===
# LOG_SENTINEL_NOTIFY_TYPE=feishu
# LOG_SENTINEL_NOTIFY_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# LOG_SENTINEL_NOTIFY_SECRET=
# LOG_SENTINEL_NOTIFY_NAME=飞书告警
