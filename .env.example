# OpsPanel 环境变量配置
# 复制此文件为 .env 并按需修改

# === 日志目录 ===
# 宿主机上要监控的日志目录，会以只读方式挂载到容器 /mnt/logs
LOG_DIR=/var/log

# === 基本 ===
TZ=Asia/Shanghai
LISTEN_PORT=9090
# DATA_DIR=/data
# LISTEN_ADDR=:9090
# GIN_MODE=release

# === 数据库 ===
# 支持 sqlite / mysql / postgres，默认 sqlite
# DB_DRIVER=sqlite
# DB_DSN=/data/sentinel.db
# DB_DRIVER=mysql
# DB_DSN=user:pass@tcp(127.0.0.1:3306)/opspanel?charset=utf8mb4&parseTime=True
# DB_DRIVER=postgres
# DB_DSN=host=127.0.0.1 user=admin password=pass dbname=opspanel port=5432 sslmode=disable

# === JWT ===
# 用于签发登录 token 的密钥，生产环境务必修改
# JWT_SECRET=your-secret-key-change-me

# === Filebeat 接收认证 ===
# 设置后 Filebeat 推送需携带此 Key，为空则不校验
# INGEST_API_KEY=

# === 定时任务 ===
# LOG_SENTINEL_SCHEDULE_ENABLED=true
# LOG_SENTINEL_SCHEDULE_CRON=0 9 * * *
# LOG_SENTINEL_SCHEDULE_HOURS=24
# LOG_SENTINEL_SCHEDULE_MAX_BYTES=12000

# === 快速通知渠道（仅当 config.json 中无渠道时生效） ===
# LOG_SENTINEL_NOTIFY_TYPE=feishu
# LOG_SENTINEL_NOTIFY_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# LOG_SENTINEL_NOTIFY_SECRET=
# LOG_SENTINEL_NOTIFY_NAME=飞书告警

# === LLM 配置 ===
# 已移至 Web 面板管理（支持多提供商），无需在此配置
